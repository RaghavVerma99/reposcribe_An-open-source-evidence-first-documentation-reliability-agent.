# RepoScribe configuration.
# This file is a reference checklist, not an auto-loaded dotenv file.
# The backend reads values from the process environment; export them in your
# shell or process manager before starting uvicorn. Never commit a real .env.
#
# Values are backend-only: do not expose secrets through a VITE_ variable.

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_PORT=8000
# Backend log verbosity (DEBUG, INFO, WARNING, ERROR).
REPOSCRIBE_LOG_LEVEL=INFO

# Upload and extraction limits (SPEC NFR-01, NFR-02)
MAX_UPLOAD_MB=20
MAX_EXTRACTED_FILES=5000
MAX_FILE_MB=2
MAX_EXTRACTED_MB=200
WORKSPACE_ROOT=./.reposcribe-workspaces
WORKSPACE_TTL_MINUTES=120

# Model provider.
# local_demo (default) is deterministic and rule-based; no model is contacted.
# alan is implemented but disabled until the integration contract is verified
# against the current event instructions. See docs/alan-integration.md.
MODEL_PROVIDER=local_demo
MODEL_NAME=
MODEL_LICENSE=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_INPUT_TOKENS=32000

# Alan platform settings.
# Leave empty until the product, SDK, auth scheme, and permitted open model are confirmed.
# These names are placeholders, not a verified contract.
ALAN_API_KEY=
ALAN_WORKFLOW_ID=
ALAN_BASE_URL=